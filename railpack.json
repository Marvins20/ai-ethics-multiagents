{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "inputs": [{ "local": "." }],
      "commands": [
        "uv sync"
      ]
    },
    "migrate": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "uv run alembic upgrade head"
      ]
    },
    "build": {
      "inputs": [{ "step": "migrate" }],
      "commands": []
    }
  },
  "deploy": {
    "startCommand": "uv run uvicorn src.app:app --host 0.0.0.0 --port $PORT --workers 1"
  }
}
