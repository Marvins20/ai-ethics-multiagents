# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
EMBEDDING_MODEL_NAME=models/gemini-embedding-001

# ── PostgreSQL (Supabase) ──────────────────────────────────────────────────────
# Async URL used by FastAPI / SQLAlchemy at runtime
DATABASE_URL=postgresql+asyncpg://postgres:<password>@<host>:5432/postgres
# Sync URL used by Alembic for migrations (same credentials, different driver prefix)
DATABASE_URL_SYNC=postgresql+psycopg://postgres:<password>@<host>:5432/postgres

# ── Redis (Upstash or local) ───────────────────────────────────────────────────
# Local:   redis://localhost:6379
# Upstash: rediss://default:<password>@<host>:6380
REDIS_URL=redis://localhost:6379

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Frontend API key ───────────────────────────────────────────────────────────
# Static key the frontend must send in X-Api-Key on every request.
# Leave empty to disable the check (local dev).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FRONTEND_API_KEY=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all (local dev).
# Production: https://your-app.vercel.app
# Local:      http://localhost:5173,http://localhost:8080
CORS_ORIGINS=*

# ── LLM provider ──────────────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic  → uses CLAUDE_API_KEY + claude-haiku-4-5-20251001
# LLM_PROVIDER=openai     → uses LLM_API_KEY + LLM_BASE_URL (RunPod/vLLM/Together/etc.)
LLM_PROVIDER=openai
CLAUDE_API_KEY=

# Model name (leave empty to use the provider default):
#   anthropic default: claude-haiku-4-5-20251001
#   openai default:    Qwen/Qwen3-27B
LLM_MODEL=Qwen/Qwen3-27B-FP8

# OpenAI-compatible provider credentials (only used when LLM_PROVIDER=openai)
# RunPod serverless OpenAI proxy: https://api.runpod.ai/v2/<endpoint-id>/openai/v1
#   NOTE: the /run endpoint is for raw async jobs — use /openai/v1 for ChatOpenAI
# RunPod persistent pod:          https://<pod-id>-8000.proxy.runpod.net/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.runpod.ai/v2/c7ro71mapfm9tl/openai/v1

# ── LangSmith tracing (optional) ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=ai-ethics-multiagents

# ── Data paths ─────────────────────────────────────────────────────────────────
AI_RISK_DATA_DIR=data/raw/ai_risk_database_v3.csv
